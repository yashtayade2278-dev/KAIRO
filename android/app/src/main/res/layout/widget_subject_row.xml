<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="horizontal"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
    <TextView android:id="@+id/subject_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#243E38" android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/subject_cover" android:layout_width="56dp" android:layout_height="wrap_content" android:gravity="end"
        android:textSize="12sp" android:textColor="#243E38" />
    <TextView android:id="@+id/subject_revision" android:layout_width="88dp" android:layout_height="wrap_content" android:gravity="end"
        android:textSize="12sp" android:textColor="#243E38" />
</LinearLayout>
