<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/subject_name" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#292522"
        android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/subject_counts" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#654C45" />
</LinearLayout>
